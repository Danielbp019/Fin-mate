# ====================
# Servidor
# ====================
PORT=                           # Puerto donde corre Express (ej: 3000)
NODE_ENV=                       # development | production | test
FRONTEND_URL=                   # URL del frontend (ej: http://localhost:5173)

# ====================
# Base de Datos (MariaDB)
# ====================
DB_HOST=                        # Host de la BD (ej: localhost)
DB_PORT=                        # Puerto de la BD (ej: 3306)
DB_USER=                        # Usuario de la BD
DB_PASSWORD=                    # Contraseña de la BD
DB_NAME=                        # Nombre de la BD (ej: finmate)
DATABASE_URL=mysql://usuario:Contraseña@localhost:3306/DBnombre     # URL completa de conexión (mysql://user:pass@host:port/db)

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=900000     # Ventana de tiempo en milisegundos (ej: 900000 = 15 min)
RATE_LIMIT_MAX=100              # Máximo de requests por ventana (ej: 100)

# ====================
# JWT (Autenticación)
# ====================
JWT_SECRET=                     # Clave secreta para firmar tokens
JWT_EXPIRES_IN_SECONDS=900      # Duración del Access Token en segundos (ej: 900 = 15 min)
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000  # Duración del Refresh Token en segundos (ej: 2592000 = 30 días)
