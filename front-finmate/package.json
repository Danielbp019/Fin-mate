    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
